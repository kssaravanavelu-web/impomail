{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vvuasmkivpacntavuqgu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "impomail-mcp",
      "version": "0.1.0",
      "title": "ImpoMail"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get profile",
        "description": "Returns the signed-in ImpoMail user's basic profile (id, email).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_messages",
        "title": "List messages",
        "description": "List the signed-in user's ImpoMail messages, optionally filtered by folder (default: inbox), category, unread, or starred. Returns a compact summary; use `get_message` for full body.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "enum": [
                "inbox",
                "sent",
                "drafts",
                "trash",
                "archive"
              ],
              "description": "Folder to list. Defaults to inbox."
            },
            "category": {
              "type": "string",
              "enum": [
                "payment",
                "jobs",
                "internships",
                "otp",
                "recharges",
                "personal",
                "promotions",
                "updates"
              ],
              "description": "Filter by category."
            },
            "unreadOnly": {
              "type": "boolean",
              "description": "Only return unread messages."
            },
            "starredOnly": {
              "type": "boolean",
              "description": "Only return starred messages."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Max messages to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_messages",
        "title": "Search messages",
        "description": "Full-text search across the signed-in user's ImpoMail messages (subject, sender, preview, body).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Text to search for."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Max results (default 20)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_message",
        "title": "Get message",
        "description": "Fetch a single ImpoMail message by id, including its full body.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Message id from list_messages / search_messages."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
